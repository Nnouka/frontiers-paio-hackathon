{
  "name": "frontiers-paio-functions",
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase serve --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:logs",
    "test": "firebase emulators:exec --project frontiers-paio-dev --config ../firebase.json --only firestore,auth \"vitest run\"",
    "seed:pharmacies": "ts-node src/scripts/seedPharmacies.ts",
    "seed:pharmacy-users": "ts-node src/scripts/seedPharmacyUsers.ts"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "frontiers-paio-app": "file:..",
    "geofire-common": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "private": true
}
